# Modelo das variáveis de ambiente do docker-compose.yml.
# Jeito rápido:  ./scripts/gerar-env.sh   (cria o .env com senhas e chave aleatórias)
# Jeito manual:  cp .env.example .env     e preencha os três campos vazios.
# O .env está no .gitignore: nenhuma senha vai para o Git.

# ----- PostgreSQL (container guardario-db) -----
POSTGRES_DB=guardario
POSTGRES_USER=guardario
# Obrigatória. A API usa a mesma senha para conectar (DB_PASSWORD no compose).
POSTGRES_PASSWORD=

# ----- API (container guardario-api) -----
# Obrigatória: chave HS256 do JWT, com 32 caracteres ou mais. Sem ela a API não sobe no perfil prod.
JWT_SECRET=

# Obrigatórias: primeiro ADMIN, criado na primeira subida. É com ele que se faz o CRUD.
# A senha precisa ter 8 caracteres ou mais.
ADMIN_EMAIL=admin@guardario.com
ADMIN_PASSWORD=

# Swagger UI em http://IP-DA-VM:8080/swagger-ui.html (true para a demonstração)
SWAGGER_ENABLED=true

# Carga de demonstração (áreas, estações, abrigos e usuários de teste com senha conhecida).
# Fica desligada na nuvem: o banco começa vazio e o CRUD prova a gravação.
SEED_ENABLED=false

# Origens liberadas no CORS para o app (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*

# ----- Portas publicadas na VM -----
API_PORT=8080
DB_PORT=5432
